Screen {
    layout: vertical;
    background: $surface;
}

#status-bar {
    height: 1;
    background: $surface-lighten-1;
    padding: 0 2;
}

#status-left {
    width: 1fr;
}

#status-right {
    width: auto;
}

#transcript {
    height: 1fr;
    padding: 1 2;
    scrollbar-size-vertical: 1;
}

#input-bar {
    height: auto;
    padding: 1 2 0 2;
}

#input-row {
    height: auto;
}

#prompt {
    width: 1fr;
    border: round $primary;
}

#input-hint {
    height: 1;
    color: $text-muted;
    text-align: right;
}

.msg-header {
    margin-top: 1;
}

.user-bubble {
    /* No box: a single heavy rule on the left, like the reference client.
       The round border + filled background read as a chat bubble and cost
       two rows plus two columns on every message for decoration.
       NOTE: the color must be a plain hex variable ($surface-lighten-2):
       $text-muted expands to `ansi_default 50%` (color + opacity, with a
       space), which does not fit border's <bordertype> <color> shape and
       fails stylesheet parsing. */
    border-left: heavy $surface-lighten-2;
    padding: 0 1;
    margin: 0 2;
    /* 1fr, not auto: auto shrink-wraps, which left a 54-column bubble and 60
       columns of dead space beside it on a 118-column terminal. */
    width: 1fr;
}

.block-turn,
.block-tool-chunk {
    color: $text-muted;
}

.block-turn-end {
    color: $error;
}

Turn {
    /* Only .msg-header's margin-top spaces turns: both rules applied, so every
       turn boundary cost two blank rows. */
    margin-bottom: 0;
}

Turn Collapsible {
    margin-left: 2;
}

/* Textual's Collapsible ships `border-top: hkey $background` and
   `padding-bottom: 1`.  Neither was ever ours: a collapsed fold then spends
   three rows on one line of text and rules a full-width line across the
   transcript.  Step folds (M3) carry no status mark, so they keep `▶` as their
   only disclosure cue; tool folds drop it in favour of their own ▸/✓/✗. */
Transcript Collapsible {
    border: none;
    padding-bottom: 0;
}

Turn Collapsible > CollapsibleTitle {
    color: $warning;
}

Turn Collapsible.tool-ok > CollapsibleTitle {
    color: $success;
}

Turn Collapsible.tool-failed > CollapsibleTitle {
    color: $error;
}

/* The plan fold is neutral state, not a warning: without this it inherits
   the $warning yellow above.  Same selector shape as the tool-ok/tool-failed
   overrides, so it wins for the same specificity reason. */
Turn .plan-state > CollapsibleTitle {
    color: $text-muted;
}

Turn .tool-card {
    border: round $surface-lighten-2;
    padding: 0 1;
    margin-left: 2;
}

Turn .tool-kind {
    color: $text-muted;
}

Turn .tool-foot-ok {
    text-align: right;
    color: $success;
}

Turn .tool-foot-bad {
    text-align: right;
    color: $error;
}

ApprovalScreen,
AskScreen {
    align: center middle;
}

#approval-box,
#ask-box {
    width: 70;
    height: auto;
    padding: 1 2;
    border: round $primary;
    background: $surface-lighten-1;
}

#approval-box {
    width: 60;
    max-height: 90%;
}

#approval-body-scroll {
    height: auto;
    max-height: 16;
}

#approval-body {
    height: auto;
}

#approval-hint {
    color: $text-muted;
    text-align: right;
}

#approval-buttons {
    height: auto;
    align-horizontal: right;
}

#approval-buttons Button {
    /* Textual's Button is `height: auto` over `border: block`, i.e. three rows
       (▔ / label / ▁) for one word.  `border: none` drops it to one row, and
       the variant colour (Allow green / Deny red / Stop yellow) survives it. */
    border: none;
    height: 1;
    margin-left: 2;
    padding: 0 2;
}

#ask-options {
    color: $text-muted;
    padding: 0 0 0 2;
}

#ask-input {
    margin-top: 1;
}

#ask-send {
    margin-top: 1;
}

CommandPalette {
    align: center middle;
}

CommandPalette > Vertical {
    width: 70;
    height: auto;
    max-height: 20;
    border: round $primary;
    background: $surface;
}

CommandPalette #--input {
    border: none;
    height: 1;
}

CommandPalette OptionList {
    height: auto;
    max-height: 16;
}
