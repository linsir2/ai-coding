Screen {
    layout: vertical;
    background: $surface;
}

#status-bar {
    height: 1;
    background: $surface-lighten-1;
    padding: 0 2;
}

#status-left {
    width: 1fr;
}

#status-right {
    width: auto;
}

#transcript {
    height: 1fr;
    padding: 1 2;
    scrollbar-size-vertical: 1;
}

#input-bar {
    height: auto;
    padding: 1 2 0 2;
}

#input-row {
    height: auto;
}

#prompt {
    width: 1fr;
    border: round $primary;
}

#send-icon {
    width: 3;
    content-align: center middle;
    color: $primary;
}

#input-hint {
    height: 1;
    color: $text-muted;
    text-align: right;
}

.msg-header {
    margin-top: 1;
}

.user-bubble {
    border: round $surface-lighten-2;
    background: $surface-lighten-1;
    padding: 0 1;
    margin: 0 2;
    width: auto;
}

.block-turn,
.block-tool-chunk {
    color: $text-muted;
}

.block-turn-end {
    color: $error;
}

Turn {
    margin-bottom: 1;
}

Turn Collapsible {
    margin-left: 2;
}

Turn Collapsible > CollapsibleTitle {
    color: $warning;
}

ApprovalScreen,
AskScreen {
    align: center middle;
}

#approval-box,
#ask-box {
    width: 70;
    height: auto;
    padding: 1 2;
    border: round $primary;
    background: $surface-lighten-1;
}

#approval-box {
    width: 60;
}

#approval-buttons {
    height: auto;
    align-horizontal: right;
}

#approval-buttons Button {
    margin-left: 2;
    padding: 0 2;
}

#ask-input {
    margin-top: 1;
}

#ask-send {
    margin-top: 1;
}

CommandPalette {
    align: center middle;
}

CommandPalette > Vertical {
    width: 70;
    height: auto;
    max-height: 20;
    border: round $primary;
    background: $surface;
}

CommandPalette #--input {
    border: none;
    height: 1;
}

CommandPalette OptionList {
    height: auto;
    max-height: 16;
}
